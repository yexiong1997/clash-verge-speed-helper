+// Package safeinit runs before the mihomo packages in Go's package-init order.
+// A non-directory home prevents mihomo's path initializer from even stat'ing
+// an existing user's ~/.config/mihomo. No user settings are changed on disk.
+package safeinit
+
+import "os"
+
+func init() {
+	for _, key := range []string{"HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME"} {
+		_ = os.Setenv(key, os.DevNull)
+	}
+	for _, key := range []string{"SAFE_PATHS", "SKIP_SAFE_PATH_CHECK", "SSL_CERT_FILE", "SSL_CERT_DIR"} {
+		_ = os.Unsetenv(key)
+	}
+}
