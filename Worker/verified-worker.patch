+// Verified JSON worker, derived from faceair/clash-speedtest v1.8.6
+// (GPL-3.0); see the accompanying source patch and provenance notice.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"io"
+	"math"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	_ "github.com/faceair/clash-speedtest/cmd/verified-worker/safeinit"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/constant"
+	mihomolog "github.com/metacubex/mihomo/log"
+	"golang.org/x/sys/unix"
+	"gopkg.in/yaml.v2"
+)
+
+const maxConfigBytes = 32 << 20
+const maxStreams = 128
+
+// This intentionally contains no proxy configuration or raw errors.
+type resultV1 struct {
+	Version                int     `json:"version"`
+	NodeName               string  `json:"node_name"`
+	NodeType               string  `json:"node_type"`
+	HeadAttempts           int     `json:"head_attempts"`
+	HeadSuccesses          int     `json:"head_successes"`
+	LatencyMS              float64 `json:"latency_ms"`
+	JitterMS               float64 `json:"jitter_ms"`
+	ExpectedBytes          int64   `json:"expected_bytes"`
+	ReceivedBytes          int64   `json:"received_bytes"`
+	DownloadComplete       bool    `json:"download_complete"`
+	DownloadBytesPerSecond float64 `json:"download_bytes_per_second"`
+}
+
+type rawConfig struct {
+	Proxies   []map[string]any `yaml:"proxies"`
+	Providers map[string]any   `yaml:"proxy-providers"`
+}
+
+type options struct {
+	config, filter, server string
+	size                   int64
+	streams                int
+	timeout, latency       time.Duration
+	rename, json           bool
+}
+
+func parseOptions() (options, bool) {
+	var o options
+	fs := flag.NewFlagSet("verified-worker", flag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	fs.StringVar(&o.config, "c", "", "")
+	fs.StringVar(&o.filter, "f", "", "")
+	fs.StringVar(&o.server, "server-url", "", "")
+	fs.Int64Var(&o.size, "download-size", 0, "")
+	fs.IntVar(&o.streams, "concurrent", 0, "")
+	fs.DurationVar(&o.timeout, "timeout", 0, "")
+	fs.DurationVar(&o.latency, "max-latency", 0, "")
+	fs.BoolVar(&o.rename, "rename", true, "")
+	fs.BoolVar(&o.json, "json-v1", false, "")
+	if fs.Parse(os.Args[1:]) != nil || fs.NArg() != 0 || o.config != "/dev/stdin" ||
+		o.filter == "" || o.server == "" || !o.json || o.rename || o.streams < 1 ||
+		o.streams > maxStreams || o.size < int64(o.streams) ||
+		o.size > math.MaxInt64-maxStreams || o.timeout <= 0 || o.latency <= 0 {
+		return o, false
+	}
+	return o, true
+}
+
+// Inherited descriptors are silenced before parsing any private data; only
+// the explicitly constructed result is written to the saved stdout descriptor.
+func resultOutput() (*os.File, bool) {
+	fd, err := unix.Dup(1)
+	if err != nil {
+		return nil, false
+	}
+	result := os.NewFile(uintptr(fd), "result")
+	null, err := os.OpenFile(os.DevNull, os.O_WRONLY, 0)
+	if err != nil {
+		result.Close()
+		return nil, false
+	}
+	defer null.Close()
+	if unix.Dup2(int(null.Fd()), 1) != nil || unix.Dup2(int(null.Fd()), 2) != nil {
+		result.Close()
+		return nil, false
+	}
+	return result, true
+}
+
+func main() {
+	out, ok := resultOutput()
+	if !ok {
+		os.Exit(1)
+	}
+	defer out.Close()
+	mihomolog.SetLevel(mihomolog.SILENT)
+	if run(out) != 0 {
+		os.Exit(1)
+	}
+}
+
+func run(out io.Writer) (status int) {
+	status = 1
+	defer func() {
+		if recover() != nil {
+			status = 1
+		}
+	}()
+	o, ok := parseOptions()
+	if !ok {
+		return 1
+	}
+	filter, err := regexp.Compile(o.filter)
+	if err != nil {
+		return 1
+	}
+	u, err := url.Parse(o.server)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.Opaque != "" || u.Fragment != "" {
+		return 1
+	}
+	bytes, err := io.ReadAll(io.LimitReader(os.Stdin, maxConfigBytes+1))
+	if err != nil || len(bytes) > maxConfigBytes {
+		return 1
+	}
+	// Reject duplicate mapping keys before permissive struct decoding can hide them.
+	var checked any
+	if yaml.UnmarshalStrict(bytes, &checked) != nil {
+		return 1
+	}
+	var cfg rawConfig
+	if yaml.Unmarshal(bytes, &cfg) != nil || len(cfg.Providers) != 0 {
+		return 1
+	}
+	var selected map[string]any
+	var name string
+	for _, p := range cfg.Proxies {
+		n, valid := p["name"].(string)
+		if !valid || n == "" || !filter.MatchString(n) {
+			continue
+		}
+		if selected != nil {
+			return 1
+		}
+		selected, name = p, n
+	}
+	if selected == nil {
+		return 1
+	}
+	// Reject unsafe nodes before invoking any adapter constructor.
+	p, err := constructValidated(selected, func(node map[string]any) (constant.Proxy, error) {
+		return adapter.ParseProxy(node)
+	})
+	if err != nil {
+		return 1
+	}
+	// Match the upstream speedtester allow-list, rather than groups/providers.
+	switch p.Type() {
+	case constant.Shadowsocks, constant.ShadowsocksR, constant.Snell, constant.Socks5, constant.Http,
+		constant.Vmess, constant.Vless, constant.Trojan, constant.Hysteria, constant.Hysteria2,
+		constant.Tuic, constant.Mieru, constant.AnyTLS, constant.Sudoku:
+	default:
+		return 1
+	}
+	chunk := o.size / int64(o.streams)
+	target := o.server
+	// Preserve upstream's download-server base URL mode.
+	if strings.Trim(u.Path, "/") == "" && u.RawQuery == "" {
+		target = strings.TrimRight(o.server, "/") + "/__down?bytes=" + strconv.FormatInt(chunk, 10)
+	}
+	res := resultV1{Version: 1, NodeName: name, NodeType: p.Type().String(),
+		HeadAttempts: 6, ExpectedBytes: chunk * int64(o.streams)}
+	latencies := testHeads(p, target, o.latency)
+	res.HeadSuccesses = len(latencies)
+	if len(latencies) > 0 {
+		var sum float64
+		for _, d := range latencies {
+			sum += float64(d) / float64(time.Millisecond)
+		}
+		res.LatencyMS = sum / float64(len(latencies))
+		var variance float64
+		for _, d := range latencies {
+			diff := float64(d)/float64(time.Millisecond) - res.LatencyMS
+			variance += diff * diff
+		}
+		res.JitterMS = math.Sqrt(variance / float64(len(latencies)))
+	}
+	results := make(chan transfer, o.streams)
+	var wg sync.WaitGroup
+	started := time.Now()
+	for i := 0; i < o.streams; i++ {
+		wg.Add(1)
+		go func() {
+			v := transfer{}
+			defer func() {
+				if recover() != nil {
+					v.ok = false
+				}
+				results <- v
+				wg.Done()
+			}()
+			v = download(p, target, chunk, o.timeout)
+		}()
+	}
+	wg.Wait()
+	elapsed := time.Since(started).Seconds()
+	close(results)
+	res.DownloadComplete = true
+	for v := range results {
+		res.ReceivedBytes += v.bytes
+		if !v.ok {
+			res.DownloadComplete = false
+		}
+	}
+	if res.DownloadComplete && elapsed > 0 {
+		res.DownloadBytesPerSecond = float64(res.ReceivedBytes) / elapsed
+	} else {
+		res.DownloadComplete = false
+		res.DownloadBytesPerSecond = 0
+	}
+	if json.NewEncoder(out).Encode(res) != nil {
+		return 1
+	}
+	return 0
+}
+
+// constructValidated is the single gate to active adapter construction.
+// Keeping the constructor injectable allows tests to assert it was not called.
+func constructValidated(node map[string]any, construct func(map[string]any) (constant.Proxy, error)) (constant.Proxy, error) {
+	if !validEndpoints(node) {
+		return nil, io.ErrUnexpectedEOF
+	}
+	return construct(node)
+}
+
+// Mihomo weakly decodes ports and can cast Hysteria2 values to
+// uint16. Validate all supported endpoint forms before adapter construction.
+// Case folding and underscore replacement match mihomo's structure decoder.
+func endpointKey(key, name string) bool {
+	return strings.EqualFold(strings.ReplaceAll(key, "_", "-"), name)
+}
+
+func field(m map[string]any, name string) (any, bool, bool) {
+	var value any
+	found := false
+	for key, v := range m {
+		if endpointKey(key, name) {
+			if found {
+				return nil, false, false
+			}
+			value, found = v, true
+		}
+	}
+	return value, found, true
+}
+
+func endpointLike(key string) bool {
+	for _, name := range []string{"port", "ports", "port-range", "peers", "endpoint", "endpoints", "server-port", "server-ports"} {
+		if endpointKey(key, name) {
+			return true
+		}
+	}
+	return false
+}
+
+func stringMap(value any) (map[string]any, bool) {
+	switch m := value.(type) {
+	case map[string]any:
+		return m, true
+	case map[any]any:
+		result := make(map[string]any, len(m))
+		for key, v := range m {
+			k, ok := key.(string)
+			if !ok {
+				return nil, false
+			}
+			result[k] = v
+		}
+		return result, true
+	default:
+		return nil, false
+	}
+}
+
+// No other nested endpoint forms are accepted, including maps inside arrays.
+func noNestedEndpoints(value any) bool {
+	switch v := value.(type) {
+	case []any:
+		for _, child := range v {
+			if !noNestedEndpoints(child) {
+				return false
+			}
+		}
+	case map[string]any, map[any]any:
+		m, ok := stringMap(v)
+		if !ok {
+			return false
+		}
+		for key, child := range m {
+			if endpointLike(key) || !noNestedEndpoints(child) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func validPort(value any) bool {
+	switch v := value.(type) {
+	case int:
+		return v > 0 && v <= 65535
+	case int64:
+		return v > 0 && v <= 65535
+	case uint64:
+		return v > 0 && v <= 65535
+	default:
+		return false
+	}
+}
+
+func decimalPort(text string) (uint64, bool) {
+	if text == "" {
+		return 0, false
+	}
+	for _, c := range text {
+		if c < '0' || c > '9' {
+			return 0, false
+		}
+	}
+	n, err := strconv.ParseUint(text, 10, 16)
+	return n, err == nil && n > 0
+}
+
+func rangeSegment(segment string, requireRange bool) bool {
+	parts := strings.Split(segment, "-")
+	if len(parts) > 2 || (requireRange && len(parts) != 2) {
+		return false
+	}
+	start, ok := decimalPort(parts[0])
+	if !ok {
+		return false
+	}
+	if len(parts) == 2 {
+		end, ok := decimalPort(parts[1])
+		return ok && start <= end
+	}
+	return true
+}
+
+// Hysteria's ports field is text syntax, never a coercible numeric scalar.
+// Hysteria2 additionally understands / separators; cap both at 28 segments.
+func validPortList(value any, hy2 bool) bool {
+	text, ok := value.(string)
+	if !ok || !strings.ContainsAny(text, ",/-") || (!hy2 && strings.Contains(text, "/")) {
+		return false
+	}
+	segments := strings.Split(strings.ReplaceAll(text, "/", ","), ",")
+	if len(segments) > 28 {
+		return false
+	}
+	for _, segment := range segments {
+		if !rangeSegment(segment, false) {
+			return false
+		}
+	}
+	return true
+}
+
+func validEndpoints(node map[string]any) bool {
+	typ, ok := node["type"].(string)
+	if !ok {
+		return false
+	}
+	switch typ {
+	case "ss", "ssr", "snell", "socks5", "http", "vmess", "vless", "trojan", "hysteria", "hysteria2", "tuic", "mieru", "anytls", "sudoku":
+	default:
+		return false
+	}
+	server, hasServer, serverUnique := field(node, "server")
+	port, hasPort, portUnique := field(node, "port")
+	ports, hasPorts, portsUnique := field(node, "ports")
+	portRange, hasRange, rangeUnique := field(node, "port-range")
+	_, hasPeers, peersUnique := field(node, "peers")
+	if !serverUnique || !portUnique || !portsUnique || !rangeUnique || !peersUnique {
+		return false
+	}
+	if hasServer {
+		host, ok := server.(string)
+		if !ok || host == "" {
+			return false
+		}
+	}
+	if hasPort && !validPort(port) {
+		return false
+	}
+	if hasPorts && ((typ != "hysteria" && typ != "hysteria2") || !validPortList(ports, typ == "hysteria2")) {
+		return false
+	}
+	if hasRange {
+		text, ok := portRange.(string)
+		if typ != "mieru" || !ok || !rangeSegment(text, true) {
+			return false
+		}
+	}
+	if hasPeers {
+		return false
+	}
+	for key, child := range node {
+		// Mihomo concatenates HTTP CONNECT custom headers without validating
+		// framing. Reject the field entirely, including all decoder aliases,
+		// regardless of its value or whether it is empty.
+		if typ == "http" && endpointKey(key, "headers") {
+			return false
+		}
+		if endpointLike(key) && !endpointKey(key, "port") && !endpointKey(key, "ports") && !endpointKey(key, "port-range") {
+			return false
+		}
+		if !noNestedEndpoints(child) {
+			return false
+		}
+	}
+	if !hasServer {
+		return false
+	}
+	switch typ {
+	case "hysteria", "hysteria2":
+		return hasPort || hasPorts
+	case "mieru":
+		return hasPort != hasRange
+	default:
+		return hasPort
+	}
+}
+
+// Same dial model as upstream's speedtester.createClient; never consult the
+// environment's HTTP proxy, never follow redirects, and never decompress.
+func clientFor(p constant.Proxy, timeout time.Duration) *http.Client {
+	tr := &http.Transport{
+		DisableCompression: true,
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			host, port, err := net.SplitHostPort(addr)
+			if err != nil {
+				return nil, err
+			}
+			n, err := strconv.ParseUint(port, 10, 16)
+			if err != nil || n == 0 {
+				return nil, io.ErrUnexpectedEOF
+			}
+			return p.DialContext(ctx, &constant.Metadata{Host: host, DstPort: uint16(n)})
+		},
+	}
+	return &http.Client{Timeout: timeout, Transport: tr,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+}
+
+func testHeads(p constant.Proxy, target string, timeout time.Duration) []time.Duration {
+	c := clientFor(p, timeout)
+	defer c.CloseIdleConnections()
+	latencies := make([]time.Duration, 0, 6)
+	for i := 0; i < 6; i++ {
+		req, err := http.NewRequest(http.MethodHead, target, nil)
+		if err != nil {
+			continue
+		}
+		start := time.Now()
+		resp, err := c.Do(req)
+		if err != nil {
+			continue
+		}
+		resp.Body.Close()
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			latencies = append(latencies, time.Since(start))
+		}
+	}
+	return latencies
+}
+
+type transfer struct {
+	bytes int64
+	ok    bool
+}
+
+var contentRange = regexp.MustCompile(`(?i)^bytes ([0-9]+)-([0-9]+)/([0-9]+|\*)$`)
+
+func validRange(header http.Header, size int64) bool {
+	values := header.Values("Content-Range")
+	if len(values) != 1 {
+		return false
+	}
+	fields := contentRange.FindStringSubmatch(values[0])
+	if fields == nil {
+		return false
+	}
+	first, e1 := strconv.ParseInt(fields[1], 10, 64)
+	last, e2 := strconv.ParseInt(fields[2], 10, 64)
+	if e1 != nil || e2 != nil || first != 0 || last != size-1 {
+		return false
+	}
+	if fields[3] == "*" {
+		return true
+	}
+	total, err := strconv.ParseInt(fields[3], 10, 64)
+	return err == nil && total > last
+}
+
+func download(p constant.Proxy, target string, size int64, timeout time.Duration) transfer {
+	c := clientFor(p, timeout)
+	defer c.CloseIdleConnections()
+	req, err := http.NewRequest(http.MethodGet, target, nil)
+	if err != nil {
+		return transfer{}
+	}
+	req.Header.Set("Range", "bytes=0-"+strconv.FormatInt(size-1, 10))
+	req.Header.Set("Accept-Encoding", "identity")
+	resp, err := c.Do(req)
+	if err != nil {
+		return transfer{}
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 ||
+		(resp.StatusCode == http.StatusPartialContent && !validRange(resp.Header, size)) {
+		return transfer{}
+	}
+	// size+1 distinguishes a genuine EOF at exactly size from excess data.
+	r := &io.LimitedReader{R: resp.Body, N: size + 1}
+	n, readErr := io.Copy(io.Discard, r)
+	return transfer{bytes: n, ok: readErr == nil && n == size && r.N > 0}
+}
