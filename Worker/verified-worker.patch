+package main
+
+import (
+	"errors"
+	"net"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/constant"
+)
+
+func testPeer(port any) map[string]any   { return map[string]any{"server": "localhost", "port": port} }
+func testWG(peers ...any) map[string]any { return map[string]any{"type": "wireguard", "peers": peers} }
+func testHy(kind string, ports any) map[string]any {
+	return map[string]any{"type": kind, "server": "localhost", "ports": ports}
+}
+func testMieru(r any) map[string]any {
+	return map[string]any{"type": "mieru", "server": "localhost", "port-range": r}
+}
+
+// Run this test binary only under a deny-network sandbox. Verify policy by
+// observing permission failures, not ordinary connection-refused errors.
+func TestEndpointNetworkDenied(t *testing.T) {
+	forbidden := func(err error) bool { return errors.Is(err, syscall.EACCES) || errors.Is(err, syscall.EPERM) }
+	c, err := net.DialTimeout("tcp", "127.0.0.1:1", time.Second)
+	if c != nil {
+		c.Close()
+	}
+	if !forbidden(err) {
+		t.Fatal("TCP deny canary did not return a permission error")
+	}
+	u, err := net.DialTimeout("udp", "127.0.0.1:1", time.Second)
+	if err == nil {
+		_, err = u.Write([]byte{0})
+		u.Close()
+	}
+	if !forbidden(err) {
+		t.Fatal("UDP deny canary did not return a permission error")
+	}
+}
+
+func TestEndpointPorts(t *testing.T) {
+	valid := []struct {
+		name string
+		node map[string]any
+	}{
+		{"h1-low", testHy("hysteria", "1-1")},
+		{"h1-high", testHy("hysteria", "65535-65535")},
+		{"h1-list", testHy("hysteria", "1,65535")},
+		{"h2-low", testHy("hysteria2", "1-1")},
+		{"h2-high", testHy("hysteria2", "65535-65535")},
+		{"h2-slash", testHy("hysteria2", "1/65535")},
+		{"h2-28", testHy("hysteria2", strings.TrimSuffix(strings.Repeat("1,", 28), ","))},
+		{"mieru-low", testMieru("1-1")},
+		{"mieru-high", testMieru("65535-65535")},
+		{"vless-low", map[string]any{"type": "vless", "server": "localhost", "port": 1}},
+		{"ss-high", map[string]any{"type": "ss", "server": "localhost", "port": 65535}},
+		{"folded-h2", map[string]any{"type": "hysteria2", "server": "localhost", "portſ": "1-2"}},
+	}
+	for _, tc := range valid {
+		t.Run(tc.name, func(t *testing.T) {
+			if !validEndpoints(tc.node) {
+				t.Fatal("valid endpoint rejected")
+			}
+		})
+	}
+	invalid := []struct {
+		name string
+		node map[string]any
+	}{
+		{"wg-peer-low-disabled", testWG(testPeer(1))},
+		{"wg-peer-high-disabled", testWG(testPeer(65535))},
+		{"wg-multiple-disabled", testWG(testPeer(1), testPeer(65535))},
+		{"wg-root-disabled", map[string]any{"type": "wireguard", "server": "localhost", "port": 1}},
+		{"wg-both-disabled", map[string]any{"type": "wireguard", "server": "localhost", "port": 1, "peers": []any{testPeer(65535)}}},
+		{"wg-negative", testWG(testPeer(-1))},
+		{"wg-zero", testWG(testPeer(0))},
+		{"wg-overflow", testWG(testPeer(65536))},
+		{"wg-wrap", testWG(testPeer(65537))},
+		{"wg-max-uint", testWG(testPeer(^uint64(0)))},
+		{"wg-string", testWG(testPeer("1"))},
+		{"wg-float", testWG(testPeer(1.0))},
+		{"wg-bool", testWG(testPeer(true))},
+		{"wg-null", testWG(testPeer(nil))},
+		{"wg-second", testWG(testPeer(1), testPeer(65537))},
+		{"wg-first", testWG(testPeer(-1), testPeer(1))},
+		{"wg-empty", testWG()},
+		{"wg-nested", testWG([]any{testPeer(1)})},
+		{"wg-peer-missing", testWG(map[string]any{"server": "localhost"})},
+		{"wg-peer-alias", testWG(map[string]any{"server": "localhost", "port": 1, "PORT": 65537})},
+		{"wg-peer-extra", testWG(map[string]any{"server": "localhost", "port": 1, "opts": []any{map[string]any{"port": -1}}})},
+		{"wg-peer-unicode-alias", map[string]any{"type": "wireguard", "peers": []any{testPeer(1)}, "peerſ": []any{testPeer(65537)}}},
+		{"wg-root-with-peer", map[string]any{"type": "wireguard", "server": "localhost", "port": 65537, "peers": []any{testPeer(1)}}},
+		{"wg-dns", map[string]any{"type": "wireguard", "dns": []any{"localhost"}, "peers": []any{testPeer(1)}}},
+		{"h1-zero", testHy("hysteria", "0-1")},
+		{"h1-reversed", testHy("hysteria", "2-1")},
+		{"h1-slash", testHy("hysteria", "1/2")},
+		{"h1-overflow", testHy("hysteria", "1-65536")},
+		{"h2-wrap", testHy("hysteria2", "1-65537")},
+		{"h2-wrapped-list", testHy("hysteria2", "1,65537")},
+		{"h2-slash-wrap", testHy("hysteria2", "1/65537")},
+		{"h2-29", testHy("hysteria2", strings.TrimSuffix(strings.Repeat("1,", 29), ","))},
+		{"h2-bare-number", testHy("hysteria2", "1")},
+		{"h2-quoted-suffix", testHy("hysteria2", "1-2junk")},
+		{"h2-unicode-wrap", map[string]any{"type": "hysteria2", "server": "localhost", "portſ": "1,65537"}},
+		{"h2-unicode-duplicate", map[string]any{"type": "hysteria2", "server": "localhost", "ports": "1-2", "portſ": "1-2"}},
+		{"mieru-zero", testMieru("0-1")},
+		{"mieru-overflow", testMieru("1-65536")},
+		{"mieru-wrap", testMieru("1-65537")},
+		{"mieru-suffix", testMieru("1-2x")},
+		{"nested-array", map[string]any{"type": "vless", "server": "localhost", "port": 1, "extra": []any{[]any{map[string]any{"port": 65537}}}}},
+	}
+	for _, tc := range invalid {
+		t.Run(tc.name, func(t *testing.T) {
+			if validEndpoints(tc.node) {
+				t.Fatal("invalid endpoint accepted")
+			}
+		})
+	}
+}
