+// Assert the real entry-point gate prevents construction, not merely that a
+// no-gVisor build or a denied network connection eventually fails.
+func TestAdapterConstructionPreflight(t *testing.T) {
+	cases := []struct {
+		name string
+		node map[string]any
+		allow bool
+	}{
+		{"ssh-password", map[string]any{"type": "ssh", "server": "localhost", "port": 22, "password": "fixture"}, false},
+		{"ssh-inline-key", map[string]any{"type": "ssh", "server": "localhost", "port": 22, "private-key": "PRIVATE KEY"}, false},
+		{"wg-peer", testWG(testPeer(1)), false},
+		{"wg-workers", map[string]any{"type": "wireguard", "server": "localhost", "port": 1, "workers": 1000000000}, false},
+		{"http-injected-name", map[string]any{"type": "http", "server": "localhost", "port": 1, "headers": map[string]any{"X\r\nBad": "x"}}, false},
+		{"http-injected-value", map[string]any{"type": "http", "server": "localhost", "port": 1, "HEADERS": map[string]any{"X": "x\r\nBad: y"}}, false},
+		{"http-unicode-alias", map[string]any{"type": "http", "server": "localhost", "port": 1, "headerſ": map[string]any{"X": "x"}}, false},
+		{"http-empty", map[string]any{"type": "http", "server": "localhost", "port": 1, "headers": map[string]any{}}, false},
+		{"http-null", map[string]any{"type": "http", "server": "localhost", "port": 1, "headers": nil}, false},
+		{"http-weak-value", map[string]any{"type": "http", "server": "localhost", "port": 1, "headers": map[string]any{"X": 1}}, false},
+		{"http-safe-no-headers", map[string]any{"type": "http", "server": "localhost", "port": 1}, true},
+		{"vless", map[string]any{"type": "vless", "server": "localhost", "port": 1}, true},
+		{"ss", map[string]any{"type": "ss", "server": "localhost", "port": 1}, true},
+		{"hysteria2", testHy("hysteria2", "1-2"), true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			marker := errors.New("constructor was called")
+			_, err := constructValidated(tc.node, func(map[string]any) (constant.Proxy, error) {
+				calls++
+				return nil, marker
+			})
+			if tc.allow {
+				if calls != 1 || !errors.Is(err, marker) {
+					t.Fatal("valid node did not reach constructor exactly once")
+				}
+			} else if calls != 0 || err == nil {
+				t.Fatal("unsafe node reached adapter construction")
+			}
+		})
+	}
+}
